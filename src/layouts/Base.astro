---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';
import { analytics, analyticsPlaceholders, SITE_URL } from '../data/config';
import { person } from '../data/content';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  /** Which sky sits behind the page. */
  scene?: 'constellations' | 'orbit' | 'still';
  /** Show the Website Mayhem toggle, on the page that has that section. */
  mayhem?: boolean;
}

const { title, description, image = '/og.png', noindex = false, scene = 'still', mayhem = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const imageUrl = new URL(image, SITE_URL).href;

const configured = (id: string) => (analyticsPlaceholders.includes(id) ? '' : id);
const googleTagId = configured(analytics.googleTagId);
const umamiId = configured(analytics.umamiWebsiteId);
const umamiSrc = analytics.umamiScriptSrc;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: SITE_URL,
  image: imageUrl,
  email: `mailto:${person.email}`,
  jobTitle: person.jobTitle,
  worksFor: { '@type': 'Organization', name: person.employer },
  alumniOf: { '@type': 'CollegeOrUniversity', name: person.school },
  sameAs: [person.github, person.linkedin],
};
const jsonLd = JSON.stringify(personSchema).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    {
      googleTagId && import.meta.env.PROD && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${googleTagId}`}></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
          </script>
        </Fragment>
      )
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Loads Umami only on the live site, once its ID is set. -->
    <script is:inline define:vars={{ umamiId, umamiSrc }}>
      (function () {
        var host = location.hostname;
        var isLocal =
          location.protocol === 'file:' ||
          host === 'localhost' ||
          host === '127.0.0.1' ||
          host === '[::1]' ||
          host === '0.0.0.0' ||
          host.endsWith('.local');
        if (isLocal) return;

        if (umamiId) {
          var umami = document.createElement('script');
          umami.id = 'umami-script';
          umami.defer = true;
          umami.src = umamiSrc;
          umami.dataset.websiteId = umamiId;
          document.head.appendChild(umami);
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#07090d" />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('theme') === '8-bit') {
          document.documentElement.classList.add('eight-bit');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <canvas id="sky" data-scene={scene} aria-hidden="true"></canvas>
    <Sidebar showKeyHint={mayhem} />
    <div class="page" data-page>
      <Nav />
      <main id="main">
        <slot />
      </main>
      <Footer showMayhem={mayhem} />
    </div>
    <slot name="overlay" />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
