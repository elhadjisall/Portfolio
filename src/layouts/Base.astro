---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/newsreader/opsz.css';
import '../styles/global.css';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { analytics, analyticsPlaceholders, SITE_URL } from '../data/config';
import { person } from '../data/content';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/og.png', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const imageUrl = new URL(image, SITE_URL).href;

const configured = (id: string) => (analyticsPlaceholders.includes(id) ? '' : id);
const googleTagId = configured(analytics.googleTagId);
const umamiId = configured(analytics.umamiWebsiteId);
const umamiSrc = analytics.umamiScriptSrc;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: SITE_URL,
  image: imageUrl,
  email: `mailto:${person.email}`,
  jobTitle: person.jobTitle,
  worksFor: { '@type': 'Organization', name: person.employer },
  alumniOf: { '@type': 'CollegeOrUniversity', name: person.school },
  sameAs: [person.github, person.linkedin],
};
const jsonLd = JSON.stringify(personSchema).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Loads the Google tag and Umami only on the live site, once IDs are set. -->
    <script is:inline define:vars={{ googleTagId, umamiId, umamiSrc }}>
      (function () {
        var host = location.hostname;
        var isLocal =
          location.protocol === 'file:' ||
          host === 'localhost' ||
          host === '127.0.0.1' ||
          host === '[::1]' ||
          host === '0.0.0.0' ||
          host.endsWith('.local');
        if (isLocal) return;

        if (googleTagId) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          // Waiting for load keeps this large script from slowing the page's first
          // paint. Events sent before then stay queued in dataLayer.
          window.addEventListener('load', function () {
            var tag = document.createElement('script');
            tag.async = true;
            tag.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(googleTagId);
            document.head.appendChild(tag);
          });
        }

        if (umamiId) {
          var umami = document.createElement('script');
          umami.id = 'umami-script';
          umami.defer = true;
          umami.src = umamiSrc;
          umami.dataset.websiteId = umamiId;
          document.head.appendChild(umami);
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderFont} as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <!-- Runs before paint: applies the saved theme and enables reveal styles. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <Nav />
      <div class="column">
        <main id="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
