---
import { navigation, person } from '../data/content';
import { umamiEvent } from '../lib/format';
import Icon from './Icon.astro';

const current = Astro.url.pathname;
---

<header class="nav">
  <div class="nav-inner">
    <a class="nav-mark" href="/">{person.name}</a>
    <nav aria-label="Sections">
      <ul data-nav-scroller>
        {
          navigation.map(({ id, label }) => (
            <li>
              <a
                href={`/${id}/`}
                data-nav-link={id}
                aria-current={current.startsWith(`/${id}`) ? 'page' : undefined}
                {...umamiEvent('nav_click', { section: id })}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
      <Icon name="theme" />
    </button>
  </div>
</header>
