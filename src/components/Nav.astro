---
import { person } from '../data/content';
import { umamiEvent } from '../lib/format';

const path = Astro.url.pathname;
const isHome = path === '/';
---

<header class="nav">
  {!isHome && <a class="nav-home" href="/">{person.name}</a>}
  <nav aria-label="Main">
    <ul>
      <li>
        <a href="/" aria-current={isHome ? 'page' : undefined} {...umamiEvent('nav_click', { section: 'home' })}>Home</a>
      </li>
      <li>
        <a
          href="/projects/"
          aria-current={path.startsWith('/projects') ? 'page' : undefined}
          {...umamiEvent('nav_click', { section: 'projects' })}>Projects</a
        >
      </li>
      <li>
        <a
          href="/profile/"
          aria-current={path.startsWith('/profile') ? 'page' : undefined}
          {...umamiEvent('nav_click', { section: 'profile' })}>Profile</a
        >
      </li>
      <li>
        <a href={person.resume} target="_blank" rel="noopener" {...umamiEvent('resume_download')}>Resume</a>
      </li>
    </ul>
  </nav>
</header>
