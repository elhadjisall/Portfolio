---
import { navigation, person } from '../data/content';
import { umamiEvent } from '../lib/format';
import Icon from './Icon.astro';
---

<header class="nav">
  <a class="nav-mark" href="/" aria-label={`${person.name}, home`}>{person.initials}</a>
  <nav aria-label="Sections">
    <ul data-nav-scroller>
      {
        navigation.map(({ id, label }) => (
          <li>
            <a href={`/#${id}`} data-nav-link={id} {...umamiEvent('nav_click', { section: id })}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
    <Icon name="theme" />
  </button>
</header>
