---
import Tags from '../components/Tags.astro';
import { person, skills } from '../data/content';
import Base from '../layouts/Base.astro';
---

<Base title={`About | ${person.name}`} description={person.bio}>
  <section class="section" data-section="about">
    <h1>About</h1>
    <p class="about-text">{person.bio}</p>
  </section>

  <section class="section" data-section="skills" aria-labelledby="skills-title">
    <h2 id="skills-title">Skills</h2>
    <dl class="skills">
      {
        skills.map(({ group, items }) => (
          <div>
            <dt>{group}</dt>
            <dd><Tags items={items} /></dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>
