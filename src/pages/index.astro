---
import { Picture } from 'astro:assets';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { person } from '../data/content';
import Base from '../layouts/Base.astro';
import { umamiEvent } from '../lib/format';
---

<Base title={`${person.name} | Software Engineer`} description={person.intro}>
  <section class="hero" data-section="hero">
    {
      person.photo && (
        <Picture
          class="avatar"
          src={person.photo}
          alt={person.name}
          formats={['avif', 'webp']}
          width={320}
          height={320}
          loading="eager"
        />
      )
    }
    <h1>Hey, I'm {person.name}</h1>
    <p class="hero-role">
      <span class="sr-only">{person.intro}</span>
      <span aria-hidden="true"><span data-typed={JSON.stringify(person.roles)}>{person.roles[0]}</span><span class="cursor"></span></span>
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href={person.resume} target="_blank" rel="noopener" {...umamiEvent('resume_download')}>
        <Icon name="file" /> Resume
      </a>
      <SocialLinks />
    </div>
  </section>
</Base>
