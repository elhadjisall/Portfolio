---
import ContactIcon from '../components/ContactIcon.astro';
import ProjectRow from '../components/ProjectRow.astro';
import WebsiteMayhem from '../components/WebsiteMayhem.astro';
import { buildingSlugs, experience, person, projectsBySlug, selectedSlugs } from '../data/content';
import Base from '../layouts/Base.astro';
import { inline, umamiEvent } from '../lib/format';
---

<Base title={`${person.name} | Software Engineer`} description={person.description} scene="constellations" mayhem>
  <section id="about" class="profile" data-section="about">
    <h1>{person.name}</h1>
    <p class="profile-line mono">
      <span class="sr-only">{person.roles.join(', ')}</span>
      <span aria-hidden="true"><span data-typed={JSON.stringify(person.roles)}>{person.roles[0]}</span><span class="cursor"></span></span>
    </p>
  </section>

  <section id="experience" class="block" data-section="experience" aria-labelledby="experience-title">
    <h2 id="experience-title" class="marker">Experience</h2>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li class="role">
            <div class="role-head">
              <span class="role-logo">
                <img src={job.logo} alt="" width="22" height="22" decoding="async" />
              </span>
              <div>
                <h3>{job.role}</h3>
                <p class="role-company">
                  <a href={job.url} {...umamiEvent('experience_click', { company: job.company })}>{job.company}</a>
                  {job.team && <span> · {job.team}</span>}
                </p>
                <p class="mono muted">{job.dates} · {job.location}</p>
              </div>
              <div class="role-metric">
                <p class="metric-value">{job.metric.value}</p>
                <p class="metric-label mono">{job.metric.label}</p>
              </div>
            </div>
            <ul class="role-bullets">
              {job.bullets.map((bullet) => <li set:html={inline(bullet)} />)}
            </ul>
            <p class="role-tech">{job.tech.join(', ')}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="building" class="block" data-section="building" aria-labelledby="building-title">
    <h2 id="building-title" class="marker">Currently building</h2>
    <div class="rows rows-wide">
      {projectsBySlug(buildingSlugs).map((project) => <ProjectRow project={project} building />)}
    </div>
  </section>

  <section id="work" class="block" data-section="work" aria-labelledby="work-title">
    <h2 id="work-title" class="marker">Past work</h2>
    <div class="rows rows-wide">
      {projectsBySlug(selectedSlugs).map((project) => <ProjectRow project={project} />)}
    </div>
    <a class="all-link" href="/projects/">ALL PROJECTS →</a>
  </section>

  <section id="contact" class="block" data-section="contact" aria-labelledby="contact-title">
    <h2 id="contact-title" class="marker">Contact</h2>
    <ul class="contact-list">
      <li class="sub"><a class="icon-link" href={`mailto:${person.email}`} aria-label="Email me" title="Email me" {...umamiEvent('social_click', { platform: 'email' })}><ContactIcon name="email" /></a></li>
      <li class="sub"><ContactIcon name="github" /><span>GitHub:</span> <a href={person.github} {...umamiEvent('social_click', { platform: 'github' })}>{person.githubName}</a></li>
      <li class="sub"><ContactIcon name="linkedin" /><span>LinkedIn:</span> <a href={person.linkedin} {...umamiEvent('social_click', { platform: 'linkedin' })}>{person.linkedinName}</a></li>
    </ul>
  </section>

  <WebsiteMayhem />

</Base>
