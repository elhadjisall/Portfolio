---
import Media from '../../components/Media.astro';
import { person, projects, type Project } from '../../data/content';
import Base from '../../layouts/Base.astro';
import { inline, umamiEvent } from '../../lib/format';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { caseStudy: study, media } = project;
const link = (link_type: string) => umamiEvent('project_click', { project: project.slug, link_type });
---

<Base title={`${project.title} | ${person.name}`} description={project.blurb}>
  <article class="study">
    <a class="back-link" href="/projects/">← ALL PROJECTS</a>
    <header class="study-header">
      <p class="mono muted">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="study-tagline">{project.tagline}</p>
      {project.credit && <p class="study-credit">{project.credit}</p>}
      <p class="study-tech">{project.tech.join(', ')}</p>
      <p class="row-links">
        <a href={project.code} {...link('code')}>Code</a>
        {project.live && <a href={project.live} {...link('live')}>Live</a>}
        {
          project.links?.map(({ label, href, type }) => (
            <a href={href} target="_blank" rel="noopener" {...link(type)}>
              {label} (PDF)
            </a>
          ))
        }
      </p>
    </header>

    <figure class="study-figure">
      <Media media={media} eager={media.kind !== 'terminal'} />
      {media.caption && <figcaption>{media.caption}</figcaption>}
    </figure>

    <section class="study-section">
      <h2 class="marker">Problem</h2>
      {study.problem.map((paragraph) => <p set:html={inline(paragraph)} />)}
    </section>

    <section class="study-section">
      <h2 class="marker">What I built</h2>
      {study.built.map((paragraph) => <p set:html={inline(paragraph)} />)}
    </section>

    {
      study.myPart && study.myPart.length > 0 && (
        <section class="study-section">
          <h2 class="marker">My part</h2>
          {study.myPart.map((paragraph) => <p set:html={inline(paragraph)} />)}
        </section>
      )
    }

    <section class="study-section">
      <h2 class="marker">How</h2>
      <ol class="flow" aria-label="Architecture, from top to bottom">
        {
          study.architecture.map((row) => (
            <li class="flow-row" style={`--boxes:${row.length}`}>
              {row.map(({ title, detail }) => (
                <div class="flow-box">
                  <strong>{title}</strong>
                  {detail && <span>{detail}</span>}
                </div>
              ))}
            </li>
          ))
        }
      </ol>
      {study.how.map((paragraph) => <p set:html={inline(paragraph)} />)}
    </section>

    {
      project.gallery?.map((item) => (
        <figure class="study-figure">
          <Media media={item} />
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))
    }

    <section class="study-section">
      <h2 class="marker">Results</h2>
      <ul class="study-list">
        {study.results.map((item) => <li set:html={inline(item)} />)}
      </ul>
    </section>

    {
      study.learned.length > 0 && (
        <section class="study-section">
          <h2 class="marker">What I learned</h2>
          <ul class="study-list">
            {study.learned.map((item) => <li set:html={inline(item)} />)}
          </ul>
        </section>
      )
    }

    <a class="next-project" href={`/projects/${next.slug}/`}>NEXT: {next.title} →</a>
  </article>
</Base>
