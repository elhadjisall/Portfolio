---
import { outside, person } from '../data/content';
import Base from '../layouts/Base.astro';
---

<Base title={`Outside of code | ${person.name}`} description={outside.text}>
  <section class="section" data-section="outside">
    <h1>Outside of code</h1>
    <p class="outside-text">{outside.text}</p>
    <div class="outside-photos">
      {
        outside.photos.map(({ src, alt, width, height }) => (
          <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
        ))
      }
    </div>
  </section>
</Base>
