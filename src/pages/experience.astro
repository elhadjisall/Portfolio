---
import Icon from '../components/Icon.astro';
import Tags from '../components/Tags.astro';
import { experience, person } from '../data/content';
import Base from '../layouts/Base.astro';
import { inline, umamiEvent } from '../lib/format';
---

<Base title={`Experience | ${person.name}`} description="Software engineering internships at Microsoft on Call of Duty authentication, and at the UNBC Robotics Lab.">
  <section class="section" data-section="experience">
    <h1>Experience</h1>
    <ol class="jobs">
      {
        experience.map((job) => (
          <li class="job">
            <span class="job-logo">
              <img src={job.logo} alt="" width="24" height="24" decoding="async" />
            </span>
            <div class="job-body">
              <h2>{job.role}</h2>
              <p class="job-company">
                <a href={job.url} {...umamiEvent('experience_click', { company: job.company })}>
                  {job.company} <Icon name="arrow" />
                </a>
                {job.team && <span> · {job.team}</span>}
              </p>
              <p class="job-meta">{job.dates} · {job.location}</p>
              <p class="job-summary">{job.summary}</p>
              <ul class="job-bullets">
                {job.bullets.map((bullet) => <li set:html={inline(bullet)} />)}
              </ul>
              <Tags items={job.tech} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
