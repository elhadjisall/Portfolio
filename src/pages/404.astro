---
import Base from '../layouts/Base.astro';
import { person } from '../data/content';
---

<Base title={`Page not found | ${person.name}`} description="This page doesn't exist." noindex>
  <section class="not-found">
    <p class="mono muted">404</p>
    <h1>Nothing at this path.</h1>
    <p>Even a bisect couldn't find this page.</p>
    <p class="row-links"><a href="/">Back home →</a></p>
  </section>
</Base>
